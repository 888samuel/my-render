{
  "name": "video-editor",
  "version": "1.0.0",
  "description": "JSON-driven Remotion editing engine for educational/documentary videos",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.524",
    "@remotion/media-utils": "4.0.524",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.524"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.524",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "compositions": "remotion compositions src/index.ts",
    "render": "remotion render VideoComposition out/video.mp4",
    "render:illustrated": "remotion render IllustratedScene out/illustrated.mp4",
    "render:low-ram": "remotion render VideoComposition out/youtube-low-ram.mp4 --concurrency=1 --disallow-parallel-encoding --jpeg-quality=80 --offthreadvideo-cache-size-in-bytes=268435456 --timeout=180000",
    "render:illustrated:low-ram": "remotion render IllustratedScene out/illustrated-low-ram.mp4 --concurrency=1 --disallow-parallel-encoding --jpeg-quality=80 --offthreadvideo-cache-size-in-bytes=268435456 --timeout=180000",
    "render:draft": "remotion render VideoComposition out/draft.mp4 --frames=0-149 --concurrency=1 --jpeg-quality=70",
    "render:illustrated:draft": "remotion render IllustratedScene out/illustrated-draft.mp4 --frames=0-89 --concurrency=1 --jpeg-quality=70",
    "still": "remotion still VideoComposition out/preview.png",
    "still:illustrated": "remotion still IllustratedScene out/illustrated-preview.png --frame=40",
    "render:capability": "remotion render CapabilityReel out/capability-10s.mp4"
  }
}
