          "start_sec": 16.2,
          "end_sec": 22,
          "placement": "left",
          "animation": { "type": "sequential" },
          "items": [
            { "number": "01", "label": "Waiting" },
            { "number": "02", "label": "Testing" },
            { "number": "03", "label": "Transformation" }
