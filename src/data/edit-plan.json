          "end_sec": 8.6,
          "placement": "center",
          "animation": { "type": "slide_up" }
        }
      ]
    },
    {
      "id": "clip_002",
      "start_sec": 7.8,
      "end_sec": 15.4,
      "transition_in": { "type": "crossfade", "duration_sec": 0.8 },
      "layers": [
        {
          "type": "image",
          "asset_id": "img_002",
          "fit": "cover",
          "motion": { "type": "subtle_movement" },
          "overlay": "dark_gradient"
        },
        {
          "type": "highlighted_text",
          "text": "Silence does not mean absence",
          "highlight": "does not mean absence",
